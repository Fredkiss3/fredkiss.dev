---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Icon from "~/components/icon.astro";
import portraitImage from "~/images/headshot.png";
import onBikeimage from "~/images/on-bike.jpeg";
import BaseLayout from "~/layouts/base-layout.astro";
import { formattedDate, capitalize } from "~/lib/utils";
import { locales, defaultLocale } from "~/i18n/config.mjs";
import { render } from "astro:content";

const workExperiences = (await getCollection("work")).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);

export async function getStaticPaths() {
  return [
    {
      params: { locale: "en" },
    },
    {
      params: { locale: "fr" },
    },
  ];
}
const { locale } = Astro.params as { locale: (typeof locales)[number] };

if (!locales.includes(locale)) {
  throw Astro.rewrite("/404");
}

const siteInfo = (await getCollection("site")).find(site => site.id == locale)!;
const userInfo = siteInfo.data;

const LABELS = {
  freelance: {
    en: "freelance",
    fr: "freelance",
  },
  "full-time": {
    en: "full-time",
    fr: "temps plein",
  },
  AT: {
    en: "at",
    fr: "chez",
  },
  creator: {
    en: "creator",
    fr: "créateur",
  },
  maintainer: {
    en: "maintainer",
    fr: "maintainer",
  },
  contributor: {
    en: "contributor",
    fr: "contributeur",
  },
} satisfies Record<string, Record<(typeof locales)[number], string>>;
---

<BaseLayout locale={locale}>
  <section
    id="banner"
    class="flex items-end gap-4 justify-between pb-8 border-b border-zinc-200 dark:border-zinc-700">
    <div class="flex flex-col gap-4">
      <h1 class="text-5xl md:text-6xl font-light font-serif">Fred Kissie</h1>

      <dl
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-600 dark:text-zinc-400">
        <div class="flex items-center gap-1.5">
          <dt>
            <span class="sr-only">Location</span><Icon
              type="map-pin"
              class="size-3.5"
            />
          </dt>
          <dd>Rennes, France</dd>
        </div>
        <span aria-hidden="true">·</span>
        <div class="flex items-center gap-1.5">
          <dt>
            <span class="sr-only">Occupation</span><Icon
              type="suitcase"
              class="size-3.5"
            />
          </dt>
          <dd class="font-medium">{userInfo.jobTitle}</dd>
        </div>
      </dl>
    </div>

    <div class="group relative flex-none size-32 md:size-40">
      <Image
        src={portraitImage}
        alt="Portrait of Fred KISSIE"
        width={500}
        height={500}
        loading="eager"
        class:list={[
          "inline absolute inset-0",
          "rounded-md object-center object-cover border-zinc-700 dark:border-white border-2",
          "group-hover:rotate-0 -rotate-6 transition duration-150",
          "md:group-hover:opacity-0",
        ]}
      />
      <Image
        src={onBikeimage}
        alt="Fred KISSIE on bike"
        width={300}
        height={500}
        loading="eager"
        class:list={[
          "inline absolute top-3 right-0",
          "rounded-md object-top object-cover border-zinc-700 dark:border-white border-2",
          "group-hover:rotate-6 -rotate-6 transition duration-150",
          "aspect-16/9 h-32 md:h-40 min-w-max",
          "opacity-0 md:group-hover:opacity-100",
        ]}
      />
    </div>
  </section>

  <section id="description" class="flex flex-col gap-4">
    <p class="text-lg">{userInfo.bio}</p>

    <ul class="flex items-center gap-2 flex-wrap">
      <li>
        <a
          class="inline-flex gap-2 items-center px-3 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-600 text-sm no-underline hover:no-underline hover:border-zinc-500 dark:hover:border-zinc-400 transition-colors"
          href="https://github.com/fredkiss3"
          target="_blank"
          rel="noopener noreferrer">
          <Icon type="github" class="size-4" />
          <span>github</span>
        </a>
      </li>
      <li>
        <button
          class="inline-flex gap-2 items-center px-3 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-600 text-sm hover:border-zinc-500 dark:hover:border-zinc-400 transition-colors cursor-pointer"
          id="email">
          <Icon type="arobase" class="size-4" />
          <span>email</span>
        </button>
      </li>
      <li>
        <a
          class="inline-flex gap-2 items-center px-3 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-600 text-sm no-underline hover:no-underline hover:border-zinc-500 dark:hover:border-zinc-400 transition-colors"
          href="https://www.linkedin.com/in/fredhel-kissie-3b6b32162/"
          target="_blank"
          rel="noopener noreferrer">
          <Icon type="linkedin" class="size-4" />
          <span>linkedin</span>
        </a>
      </li>
      <li>
        <a
          class="inline-flex gap-2 items-center px-3 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-600 text-sm no-underline hover:no-underline hover:border-zinc-500 dark:hover:border-zinc-400 transition-colors"
          href="https://bsky.app/profile/fredkiss.dev"
          target="_blank"
          rel="noopener noreferrer">
          <Icon type="bluesky" class="size-4" />
          <span>bluesky</span>
        </a>
      </li>
      <li>
        <a
          class="inline-flex gap-2 items-center px-3 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-600 text-sm no-underline hover:no-underline hover:border-zinc-500 dark:hover:border-zinc-400 transition-colors"
          href="https://twitter.com/fredkisss"
          target="_blank"
          rel="noopener noreferrer">
          <Icon type="twitter" class="size-4" />
          <span>twitter</span>
        </a>
      </li>
      <li>
        <a
          class="inline-flex gap-2 items-center px-3 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-600 text-sm no-underline hover:no-underline hover:border-zinc-500 dark:hover:border-zinc-400 transition-colors"
          href="https://twitch.tv/fredkisss"
          target="_blank"
          rel="noopener noreferrer">
          <Icon type="twitch" class="size-4" />
          <span>twitch</span>
        </a>
      </li>
    </ul>
  </section>

  <section id="work" class="flex flex-col gap-3">
    <div class="flex items-center gap-4">
      <h2 class="text-2xl font-semibold whitespace-nowrap">work</h2>
      <div class="flex-1 h-px bg-zinc-200 dark:bg-zinc-700"></div>
    </div>

    <ul class="flex flex-col gap-8">
      {
        workExperiences.map(async entry => {
          const xp = entry.data;
          const { Content } = await render(entry);

          return (
            <li>
              <article class="grid grid-cols-1 md:grid-cols-[6rem_1fr] gap-x-6 gap-y-1 items-start">
                <div class="text-sm text-zinc-500 dark:text-zinc-400 md:text-right leading-snug mb-1 md:mb-0 md:pt-1">
                  <time class="block">{formattedDate(xp.startDate)}</time>
                  {xp.endDate ? (
                    <time class="block">{formattedDate(xp.endDate)}</time>
                  ) : (
                    <span class="block text-amber-600 dark:text-amber-400 font-medium">
                      present
                    </span>
                  )}
                </div>

                <div class="flex flex-col gap-3 border-l-2 border-amber-300 dark:border-amber-700 pl-4">
                  <div class="flex flex-col gap-1">
                    <h3 class="text-xl font-semibold">
                      {xp.jobTitle[locale] ?? xp.jobTitle[defaultLocale]}{" "}
                      {LABELS["AT"][locale]}
                      <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href={xp.link}>
                        {xp.company}
                      </a>
                    </h3>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400">
                      {capitalize(LABELS[xp.type][locale])}
                    </p>
                  </div>

                  <div class="text-zinc-700/90 dark:text-white/80 [&_ul]:ms-6 [&_ul>li]:list-disc">
                    <Content />
                  </div>

                  {xp.stack.length > 0 && (
                    <div class="flex gap-1.5 items-center flex-wrap">
                      <strong class="min-w-max text-sm">Tech Stack:</strong>{" "}
                      {xp.stack.map(tech => {
                        return tech.link ? (
                          <a
                            href={tech.link}
                            class="inline-flex gap-0.5 items-center px-2 py-0.5 rounded text-xs font-medium border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-700 no-underline hover:no-underline hover:border-amber-400 dark:hover:border-amber-500 transition-colors">
                            {tech.name}
                            <Icon type="arrow-external" class="size-3" />
                          </a>
                        ) : (
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-700">
                            {tech.name}
                          </span>
                        );
                      })}
                    </div>
                  )}
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section id="projects" class="flex flex-col gap-3">
    <div class="flex items-center gap-4">
      <h2 class="text-2xl font-semibold whitespace-nowrap">Open Source</h2>
      <div class="flex-1 h-px bg-zinc-200 dark:bg-zinc-700"></div>
    </div>
    <ul class="flex flex-col">
      {
        projects.map(async (entry, index) => {
          const project = entry.data;
          const { Content } = await render(entry);
          const roleFormatted = project.roles
            .map(role => LABELS[role][locale])
            .join(" & ");
          return (
            <li class="py-12 border-t border-zinc-200 dark:border-zinc-700 first:pt-0 first:border-0">
              <article class="grid md:grid-cols-2 gap-8">
                <div class="flex flex-col col-span-full md:col-span-1 gap-4">
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-mono tracking-widest text-zinc-400 dark:text-zinc-500">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="text-xl font-semibold">
                        {project.link ? (
                          <a
                            target="_blank"
                            rel="noopener noreferrer"
                            href={project.link}>
                            {project.name}
                          </a>
                        ) : (
                          <>{project.name}</>
                        )}
                      </h3>
                      <span class="inline-flex items-center gap-1 text-amber-600 dark:text-yellow-400 text-sm">
                        <span
                          data-fetch-stars
                          data-slug={entry.id}
                          data-stars="-"
                          class="before:content-[attr(data-stars)]"
                        />
                        ⭐<span class="sr-only">stars</span>
                      </span>
                    </div>

                    <p class="text-sm lowercase text-zinc-500 dark:text-zinc-400">
                      {roleFormatted}
                    </p>
                  </div>

                  <div class="flex flex-col gap-2">
                    <div class="text-zinc-700/90 dark:text-white/80 [&_ul]:ms-6 [&_ul>li]:list-disc text-balance">
                      <Content />
                    </div>

                    <footer>
                      <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href={project.repository}
                        class="inline-flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400">
                        <Icon type="github" class="size-3.5" />
                        {project.repository.replace("https://github.com/", "")}
                        <Icon type="arrow-external" class="size-3" />
                      </a>
                    </footer>
                  </div>
                </div>

                <div
                  class:list={[
                    index % 2 === 0
                      ? "md:order-last md:-rotate-2"
                      : "md:order-first md:rotate-2",
                    "flex col-span-full md:col-span-1",
                    "flex-col justify-center items-center",
                    "md:size-full",
                    "hover:rotate-0 transition duration-150",
                  ]}>
                  {typeof project.image === "string" ? (
                    <Image
                      src={project.image}
                      alt={`Screenshot of ${project.name}`}
                      width={500}
                      height={500}
                      loading="lazy"
                      class="rounded-lg shadow-sm object-center object-contain w-full"
                    />
                  ) : (
                    <picture class="object-center object-contain w-full rounded-lg shadow-sm">
                      <source
                        media="(prefers-color-scheme: dark)"
                        srcset={project.image.dark}
                      />
                      <source
                        media="(prefers-color-scheme: light)"
                        srcset={project.image.light}
                      />
                      <Image
                        src={project.image.light}
                        alt={`Screenshot of ${project.name}`}
                        width={500}
                        height={500}
                        class="object-center object-contain size-full rounded-lg"
                      />
                    </picture>
                  )}
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </section>
  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      const emailBtn = document.querySelector(
        "button#email",
      ) as HTMLButtonElement;

      if (emailBtn) {
        emailBtn.addEventListener("click", () => {
          window.location.href =
            "mailto:hello@fredkiss.dev?subject=Contact+Website";
        });
      }

      const stars = document.querySelectorAll("[data-fetch-stars]");

      await Promise.all(
        [...stars].map(async element => {
          const slug = (element as HTMLElement).dataset.slug;
          const response = await fetch(`/api/${slug}/stars.json`).then(
            r => r.json() as Promise<{ stargazerCount: number }>,
          );

          (element as HTMLElement).dataset.stars =
            response.stargazerCount.toString();
        }),
      );
    });
  </script>
</BaseLayout>
